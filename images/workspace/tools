#!/bin/sh
# tools installs programs from conda-forge into your home, without root.
# They stay with the server across restarts, but not in snapshots.
set -e
# Kept apart by architecture: a server moved to a node of another one starts
# with none, rather than with programs that cannot run there.
prefix="$HOME/.local/tools/$(uname -m)"
export MAMBA_ROOT_PREFIX="$HOME/.local/mamba"
# Only conda-forge, whatever a .condarc in the home says.
mm() { sub=$1; shift; micromamba "$sub" --quiet --no-rc "$@"; }
forge="--override-channels --channel conda-forge"
# Downloads are deleted once done, whether it worked or not.
tidy() { micromamba clean --quiet --no-rc --all --yes >/dev/null 2>&1 || true; }

usage() {
  cat <<'TEXT'
tools: install programs into your home, no root needed.

  tools install <name>    e.g. tools install ffmpeg
  tools remove <name>
  tools list
  tools search <name>

Programs come from conda-forge.org/packages.
TEXT
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  install|add)
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    trap tidy EXIT
    if [ -d "$prefix/conda-meta" ]; then
      mm install --yes --prefix "$prefix" $forge "$@"
    else
      mm create --yes --prefix "$prefix" $forge "$@"
    fi
    case ":$PATH:" in
      *":$prefix/bin:"*) ;;
      *) echo "Installed. Start a new shell, or run: export PATH=\"$prefix/bin:\$PATH\"" ;;
    esac
    ;;
  remove|uninstall|rm)
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    trap tidy EXIT
    mm remove --yes --prefix "$prefix" "$@"
    ;;
  list|ls)
    if [ -d "$prefix/conda-meta" ]; then
      mm list --prefix "$prefix"
    else
      echo "Nothing installed yet. Try: tools install ffmpeg"
    fi
    ;;
  search|find)
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    mm search $forge "$@"
    ;;
  ""|help|-h|--help)
    usage
    ;;
  *)
    echo "tools: no command $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
