. /tmp/avsys/env 2>/dev/null
# Commands run over ssh (rsync, plain `ssh host cmd`) start in the server
# directory rather than the workspace's own home.
if [ "$PWD" = "$HOME" ] && [ -d /data ]; then cd /data; fi
[ -z "${PS1:-}" ] && return
# From here on it is a person at a prompt. What they have put in their home
# is found before what the image has.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
shopt -s checkwinsize histappend
PS1='\[\e[38;5;80m\]${AVSYS_USER:-mc}@${AVSYS_SERVER:-workspace}\[\e[0m\]:\[\e[38;5;245m\]\w\[\e[0m\]\$ '
alias ls='ls --color=auto' ll='ls -lah' grep='grep --color=auto'
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
