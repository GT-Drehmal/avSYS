. /tmp/avsys/env 2>/dev/null
# Commands run over ssh (rsync, plain `ssh host cmd`) start in the server
# directory rather than the workspace's own home.
if [ "$PWD" = "$HOME" ] && [ -d /data ]; then cd /data; fi
[ -z "${PS1:-}" ] && return
# From here on it is a person at a prompt. What they have put in their home
# is found before what the image has.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
shopt -s checkwinsize histappend
PS1='\[\e[38;5;80m\]${AVSYS_USER:-mc}@${AVSYS_SERVER:-workspace}\[\e[0m\]:\[\e[38;5;245m\]\w\[\e[0m\]\$ '
alias ls='ls --color=auto' ll='ls -lah' grep='grep --color=auto'
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
# A person opening a terminal is told what they can do here, once per
# session (not again in a shell started inside it). ~/.hushlogin turns it off.
if [ -z "${AVSYS_GREETED:-}" ] && [ -t 1 ] && [ ! -e "$HOME/.hushlogin" ]; then
  export AVSYS_GREETED=1
  printf '\n  \e[1m%s\e[0m  ·  this is the server'"'"'s folder\n\n' "${AVSYS_SERVER:-workspace}"
  printf '  \e[1mmc console\e[0m       the server console (Ctrl-D to leave)\n'
  printf '  \e[1mmc run\e[0m list      run one command and see its answer\n'
  printf '  \e[1mmc logs\e[0m          follow the server log\n'
  printf '  \e[1mmc restart\e[0m       restart the game\n'
  printf '  \e[1mtools install\e[0m    add a program, no root needed\n\n'
  printf '  Start, stop and change the server from the panel.\n\n'
fi
